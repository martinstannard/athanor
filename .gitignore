# The directory Mix will write compiled artifacts to.
/_build/

# Per-session isolated build dirs (MIX_BUILD_PATH=_build.<name>) used to keep
# concurrent agent sessions from fighting over one _build.
/_build.*/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
athanor-*.tar

# Local agent tooling, not part of the project:
#   /.claude/    — Claude Code hooks, settings and local MCP servers
#   /.chainlink/ — Chainlink issue tracker state (issues.db is a local SQLite database)
# Force-add with `git add -f <path>` if you specifically want them shared.
/.claude/
/.chainlink/

