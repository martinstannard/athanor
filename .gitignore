# The directory Mix will write compiled artifacts to.
/_build/

# Per-session isolated build dirs (MIX_BUILD_PATH=_build.<name>) used to keep
# concurrent agent sessions from fighting over one _build.
/_build.*/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
athanor-*.tar

# Local agent tooling, not part of the project:
#   /.claude/    — Claude Code hooks, settings and local MCP servers
#   /.chainlink/ — Chainlink issue tracker state (issues.db is a local SQLite database)
#   /.athanor/   — §7.5 memory for whoever runs the harness in this checkout (MEMORY.md plus the
#                  append-only learnings.jsonl). Runtime state, not project content: it is written
#                  by the harness, not reviewed by a human, and a committed MEMORY.md silently
#                  changes every session's system prompt — and every test that asserts on one.
#                  A curated, genuinely shared fact can still be committed with
#                  `git add -f .athanor/MEMORY.md`.
# Force-add with `git add -f <path>` if you specifically want them shared.
/.claude/
/.chainlink/
/.athanor/

# Local handover notes: deliberately kept out of git (machine paths, PIDs, daemon internals).
/docs/handover.md
